# ---------------------------------------------------------------------------------------------
# Blockroom environment. Copy to .env (scripts) and app/.env.local (frontend). NEVER put keys here.
# Signing is done by Foundry keystores (~/.foundry/keystores) or an external signer (Clef/web3signer).
# ---------------------------------------------------------------------------------------------

# Robinhood Chain RPC (public endpoint is rate-limited; use a dedicated provider in production)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Which deployment the off-chain services use: 4663 (mainnet) or 31337 (local anvil fork)
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- deploy (optional role overrides; default = deployer) ---
# BLOCKROOM_GUARDIAN=0x...
# BLOCKROOM_KEEPER=0x...
# BLOCKROOM_PROPOSER=0x...        # use a multisig
# BLOCKROOM_COMPLIANCE_OP=0x...
# BLOCKROOM_TREASURY=0x...        # default: Timelock

# --- relay ---
RELAY_PORT=8787
RELAY_RFQ_TTL_MS=15000
RELAY_REQUIRE_REGISTERED_MAKERS=true

# --- signer for mm-bot / keeper ---
# SIGNER=keystore -> decrypts ~/.foundry/keystores/$KEYSTORE_ACCOUNT (password from KEYSTORE_PASSWORD_FILE or prompt)
# SIGNER=rpc      -> uses the RPC node's eth_signTypedData_v4 / eth_sendTransaction for SIGNER_ADDRESS
#                    (anvil dev accounts, Clef, web3signer). No key ever enters this process.
SIGNER=keystore
KEYSTORE_ACCOUNT=blockroom-keeper
# KEYSTORE_PASSWORD_FILE=/run/secrets/keystore_password
# SIGNER_ADDRESS=0x...

# --- mm-bot ---
RELAY_URL=ws://localhost:8787
MM_SPREAD_BPS=15
MM_MAX_NOTIONAL_USDG=250000
MM_QUOTE_TTL_SEC=60

# --- keeper ---
KEEPER_POLL_MS=10000
KEEPER_REVEAL_PORT=8788
