# Frontend config (copy to app/.env.local, or set in Vercel project settings)
# 4663 = Robinhood Chain mainnet, 31337 = local anvil fork (pnpm fork)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# One or more RFQ relays (comma separated). Quotes from all are merged; a single relay cannot censor you.
NEXT_PUBLIC_RELAY_URLS=wss://relay.example.com
# Optional keeper endpoint for delegated midpoint reveals
NEXT_PUBLIC_KEEPER_URL=
# $BLKR project token. EMPTY = all token features hidden (bond-in-token, staking, fee tiers).
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional WalletConnect Cloud project id (without it only injected wallets are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes (server-side, uses Vercel geo headers)
GEOBLOCK_COUNTRIES=
